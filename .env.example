# Storage: SQLite works for a team of 20. For Postgres: docker compose up -d
DATABASE_URL=sqlite:///kept.db
# DATABASE_URL=postgresql+psycopg://kept:kept@localhost:5432/kept

# Without a key, extraction uses the offline rule extractor and the desk returns raw context.
ANTHROPIC_API_KEY=
REFLEX_MODEL=claude-haiku-5-5
DESK_MODEL=claude-sonnet-5-5

# Slack (Socket Mode). Create the app from slack-manifest.yml.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
BRIEF_CHANNEL=            # channel ID for the Monday brief, e.g. C0123456

# Linear personal API key: Settings → Security & access → Personal API keys
LINEAR_API_KEY=

KEPT_TZ=Asia/Kolkata
